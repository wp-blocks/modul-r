{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"background": true,
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": true,
			"defaultGradients": true,
			"defaultPalette": false,
			"gradients": [],
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#6F4CAD"
				},
				{
					"name": "Primary Light",
					"slug": "primary-light",
					"color": "#9B82C6"
				},
				{
					"name": "Primary Dark",
					"slug": "primary-dark",
					"color": "#4E367A"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#16BEBB"
				},
				{
					"name": "Secondary Light",
					"slug": "secondary-light",
					"color": "#5CD2D0"
				},
				{
					"name": "Secondary Dark",
					"slug": "secondary-dark",
					"color": "#108583"
				},
				{
					"name": "Black",
					"slug": "black",
					"color": "light-dark(#110e17, #ffffff)"
				},
				{
					"name": "Gray dark",
					"slug": "gray-dark",
					"color": "light-dark(#262428, #f3f3f3)"
				},
				{
					"name": "Gray",
					"slug": "gray",
					"color": "light-dark(#888888, #e3e3e3)"
				},
				{
					"name": "Gray light",
					"slug": "gray-light",
					"color": "light-dark(#e3e3e3, #888888)"
				},
				{
					"name": "White Smoke",
					"slug": "white-smoke",
					"color": "light-dark(#f3f3f3, #222222)"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "light-dark(#ffffff, #110e17)"
				},
				{
					"name": "Text Color",
					"slug": "text-color",
					"color": "var(--wp--preset--color--black)"
				},
				{
					"name": "Background",
					"slug": "background",
					"color": "var(--wp--preset--color--white)"
				}
			],
			"text": true
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1600px"
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "Box Padding",
					"slug": "box-padding",
					"size": "clamp(1.5rem, 5vw, 4rem)"
				}
			],
			"spacingScale": {
				"increment": 2,
				"mediumStep": 1,
				"operator": "*",
				"steps": 7,
				"unit": "rem"
			},
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"dropCap": true,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Default",
					"slug": "default",
					"fontFamily": "Montserrat, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "300 500",
							"src": [
								"file:./assets/fonts/montserrat/Montserrat-VariableFont_wght.woff2"
							]
						}
					]
				},
				{
					"name": "Title",
					"slug": "title",
					"fontFamily": "Montserrat, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/montserrat/Montserrat-VariableFont_wght.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "monospace, serif",
					"name": "Monospace",
					"slug": "monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Baseline",
					"size": "16px",
					"slug": "baseline"
				},
				{
					"name": "Extra small",
					"size": "0.7rem",
					"slug": "extra-small"
				},
				{
					"name": "Small",
					"size": "0.9rem",
					"slug": "small"
				},
				{
					"name": "Default",
					"size": "1rem",
					"slug": "default"
				},
				{
					"name": "Medium",
					"size": "1.4rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.8rem",
					"slug": "large"
				},
				{
					"name": "Extra large",
					"size": "2.6rem",
					"slug": "extra-large"
				},
				{
					"name": "XXL",
					"size": "4rem",
					"slug": "xx-large"
				},
				{
					"name": "XXXL",
					"size": "7rem",
					"slug": "xxx-large"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true
		}
	},
	"styles": {
		"css": ":root { color-scheme: light dark; }",
		"spacing": {
			"padding": {
				"right": "var(--wp--preset--spacing--50)",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontSize": "1rem",
					"fontStyle": "normal",
					"fontWeight": "500",
					"letterSpacing": "0.33em",
					"lineHeight": "var(--wp--custom--line-height--small)",
					"textTransform": "uppercase"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--60)"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var:preset|spacing|50"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--primary)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--60)",
						"top": "var(--wp--preset--spacing--60)"
					}
				}
			},
			"core/search": {
				"css": "& .wp-block-search__input{border-radius:3.125rem;padding-left:1.5625rem;padding-right:1.5625rem;border-color:var(--wp--preset--color--gray-light);}",
				"typography": {
					"lineHeight": "1.6"
				},
				"elements": {
					"button": {
						"border": {
							"radius": "3.125rem"
						},
						"spacing": {
							"margin": {
								"left": "1.125rem"
							}
						},
						":hover" : {
							"border": {
								"color": "transparent"
							}
						}
					}
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--primary-dark)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text-color)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"lineHeight": "1"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|title",
					"fontStyle": "normal",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--small)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary-dark)"
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"textInput": {
				"border": {
					"color": "var(--wp--preset--color--gray-light)",
					"radius": "4px",
					"width": "1px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"bottom": "0.5rem",
						"left": "0.5rem",
						"right": "0.5rem",
						"top": "0.5rem"
					}
				}
			},
			"select": {
				"border": {
					"color": "var(--wp--preset--color--gray-light)",
					"radius": "4px",
					"width": "1px",
					"style": "solid"
				},
				"spacing": {
					"padding": {
						"bottom": "0.5rem",
						"left": "0.5rem",
						"right": "0.5rem",
						"top": "0.5rem"
					}
				}
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|default",
			"fontSize": "var(--wp--preset--font-size--baseline)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--medium)"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "header",
			"name": "checkout-header",
			"title": "Checkout Header"
		},
		{
			"area": "header",
			"name": "header-search",
			"title": "Search Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		},
		{
			"area": "uncategorized",
			"name": "comments",
			"title": "Comments"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Sidebar"
		}
	]
}
